<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="jp.ruly.lecture.db.mybatis.ooka.domain.repository.MonstersMapper">
	<select id="selectAll"
		resultType="jp.ruly.lecture.db.mybatis.ooka.domain.entity.Monsters">
		SELECT id
		, name
		, hp
		, mp
		,exp
		FROM monsters
		ORDER BY id
	</select>
</mapper>